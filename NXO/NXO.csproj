<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>NXO</AssemblyName>
    <RootNamespace>NXO</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DebugType>embedded</DebugType>
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0162;CS0168;CS0219;CS0649;CS0169;CS0414;CS8632;CS1701;CS1702;CS8625;CS8600;CS8601;CS8602;CS8603;CS8604</NoWarn>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Gorilla Tag</GameDir>
    <ManagedDir>$(GameDir)\Gorilla Tag_Data\Managed</ManagedDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="obj\**;bin\**" />
    <EmbeddedResource Include="Resources.*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ManagedRefs Include="$(ManagedDir)\*.dll" Exclude="$(ManagedDir)\mscorlib.dll;$(ManagedDir)\netstandard.dll;$(ManagedDir)\System*.dll;$(ManagedDir)\Microsoft.*.dll;$(ManagedDir)\Mono.*.dll;$(ManagedDir)\0Harmony*.dll;$(ManagedDir)\Assembly-CSharp.dll;$(ManagedDir)\PhotonUnityNetworking.dll" />
    <BepRefs Include="$(BepInExCore)\*.dll" Exclude="$(BepInExCore)\0Harmony20.dll;$(BepInExCore)\System*.dll;$(BepInExCore)\mscorlib.dll;$(BepInExCore)\netstandard.dll" />
    <Reference Include="$(ManagedDir)\Assembly-CSharp.dll" Publicize="true" Private="false" />
    <Reference Include="$(ManagedDir)\PhotonUnityNetworking.dll" Publicize="true" Private="false" />
    <Reference Include="@(ManagedRefs);@(BepRefs)" Private="false" />
    <Reference Include="$(MSBuildProjectDirectory)\lib\UnityEngine.CoreModule.dll" Condition="!Exists('$(ManagedDir)\UnityEngine.CoreModule.dll')" Private="false" />
  </ItemGroup>

</Project>
